{
  // clang-format и clang-tidy берутся из расширения ms-vscode.cpptools,
  // путь к ним указывать не нужно. Стиль — из .clang-format в корне.

  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },

  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_tidy": {
    "enabled": true,
    "args": [
      // clang-tidy — x86-компилятор, а проект собирается под AVR. Заголовки
      // ядра GCC (stddef.h) avr-gcc находит сам, clang — нет, и без этого
      // анализ падает с ошибкой компиляции на каждом файле.
      // ВНИМАНИЕ: в пути зашита версия toolchain-atmelavr (7.3.0).
      // После обновления toolchain путь нужно поправить — clang-tidy начнёт
      // ругаться на stddef.h.
      "--extra-arg=-isystem",
      "--extra-arg=C:/Users/SpecCP/.platformio/packages/toolchain-atmelavr/lib/gcc/avr/7.3.0/include"
    ]
  },

  // База компиляции генерируется командой: pio run -e nano -t compiledb
  // Основной IntelliSense ведёт расширение PlatformIO; это запасной путь.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json"
}
